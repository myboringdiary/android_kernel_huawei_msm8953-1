&qusb_phy {
	qcom,qusb-phy-init-seq = <0xF8 0x80
				0x33 0x84
				0x83 0x88
				0xC0 0x8C
				0x30 0x08
				0x79 0x0C
				0x21 0x10
				0x14 0x9C
				0x9F 0x1C
				0x00 0x18>;
};

&soc {
	i2c@7af5000{
		fairchild_fsa9683: fsa9683@4c {
			compatible = "huawei,fairchild_fsa9683";
			reg = <0x4c>;
			fairchild_fsa9685,gpio-intb = <&tlmm 45 0>;
			status = "ok";
		};
		fairchild_fsa9682: fsa9682@26 {
			compatible = "huawei,fairchild_fsa9682";
			reg = <0x26>;
			fairchild_fsa9685,gpio-intb = <&tlmm 45 0>;
			status = "ok";
		};
		nxp_cbtl9689: cbtl9689@2e {
			compatible = "huawei,nxp_cbtl9689";
			reg = <0x2e>;
			fairchild_fsa9685,gpio-intb = <&tlmm 45 0>;
			status = "ok";
		};
	};
};

/* ===== NetHunter: 接入 PMIC ID 中断，恢复 OTG 检测 ===== */
&usb3 {
    /delete-property/ interrupts;
    interrupts-extended = <&intc 0 136 0>,
                          <&intc 0 220 0>,
                          <&intc 0 134 0>,
                          <&spmi_bus 0x2 0x11 0x3>;
    interrupt-names = "hs_phy_irq", "ss_phy_irq", "pwr_event_irq",
                      "pmic_id_irq";
    dwc3@7000000 {
        dr_mode = "otg";
    };
};
